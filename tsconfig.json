{
  "compilerOptions": {
    "moduleResolution": "node",
    "target": "ES2020",
    "module": "ESNext",
    "jsx": "react-jsx",

    "allowJs": true,
    "checkJs": false,
    "strict": true,
    "noEmit": true,
    

    "baseUrl": "./src",
    "paths": {
      "@model/*": ["model/*"],
      "@hooks/*": ["hooks/*"],
      "@utils/*": ["utils/*"],
    }
  },
  "include": ["src"]
}